+def bind_authoritative_publication(evidence, resolution, session_id):
+    """Request-local provenance, never campaign state or the shared evidence tail."""
+    _PUBLICATION.set((evidence, resolution, session_id))
+
+
+def prepare_authoritative_publication(resolution, session_id, player_text):
+    """Consume the current resolved action once; select only trusted/validated text."""
+    from game import integrated_investigation_narration as integrated
+    binding = _PUBLICATION.get()
+    _PUBLICATION.set(None)
+    if not integrated.authoritative_disclosure_enabled() or not experimental_publication_enabled(session_id):
+        return None
+    if not binding:
+        return None
+    evidence, bound_resolution, bound_session = binding
+    if (resolution is not bound_resolution or session_id != bound_session
+            or evidence.get('player_text') != player_text
+            or not evidence.get('eligible')):
+        return None
+    hook = evidence['hook_input']
+    # Recheck the actual current resolver fields, not prose or accumulated clues.
+    current = build_hook_input(resolution=resolution, scene={}, known_clue_texts=(),
+                               player_text=player_text)
+    if current.get('resolution') != hook.get('resolution'):
+        raise ValueError('publication_authority_changed')
+    contract, request = integrated.outcome_contract(hook)
+    trusted = integrated.trusted_disclosure(request)
+    fallback = integrated.action_fallback(contract, hook)
+    if trusted and trusted not in fallback:
+        fallback = ' '.join(filter(None, (fallback, trusted)))
+    plan = dict(evidence=evidence, request=request, trusted=trusted, fallback=fallback,
+                text=fallback, mode='fallback', recovery_reason=None)
+    try:
+        validation = evidence.get('validation') or {}
+        raw = evidence.get('raw_provider_text')
+        text = evidence.get('assembled')
+        if (evidence.get('used_fallback') is False and validation.get('decision') == 'PASS'
+                and evidence.get('disclosure_mode') == 'authoritative'
+                and evidence.get('authorized_outcome_contract') == request
+                and evidence.get('trusted_disclosure') == trusted
+                and isinstance(raw, str) and bool(raw.strip())
+                and text == evidence.get('validated_composition')
+                and text == ' '.join(filter(None, (raw.strip(), trusted)))
+                and validation.get('provenance') == 'engine_current_action_plus_validated_ai'):
+            plan.update(text=text, mode='published')
+    except Exception as exc:
+        plan['recovery_reason'] = 'presentation_selection_' + type(exc).__name__
+    return plan
+
+
+def verify_authoritative_publication(plan, targets, *, failure=None):
+    """Final server-body invariant. One deterministic recovery, no provider/resolver calls."""
+    facts = [f['text'] for f in plan['request']['must_communicate']]
+    valid = bool(targets) and all(
+        item.get('player_facing_text') == plan['text']
+        and all(fact in item['player_facing_text'] for fact in facts) for item in targets)
+    if failure or not valid:
+        plan.update(text=plan['fallback'], mode='fallback',
+                    recovery_reason=failure or 'final_response_invariant')
+        for item in targets:
+            item['player_facing_text'] = plan['fallback']
+    if not targets or not all(all(f in item.get('player_facing_text', '') for f in facts)
+                              and item.get('player_facing_text') == plan['text'] for item in targets):
+        raise ValueError('mandatory_disclosure_publication_failed')
+    for item in targets:
+        metadata = item.setdefault('metadata', {})
+        if isinstance(metadata, dict):
+            metadata['experimental_integrated_narration'] = plan['mode']
+    evidence = plan['evidence']
+    evidence['publication'] = dict(decision=plan['mode'], trusted_disclosure=plan['trusted'],
+        mandatory_disclosures=facts, final_text=plan['text'], invariant='PASS',
+        recovery_reason=plan['recovery_reason'], server_constructed=True, client_received='unknown')
+    evidence['player_facing_published'] = plan['mode'] == 'published'
+    # Retain original validation/candidate even when publication needs recovery.
+    path = evidence.get('evidence_path')
+    if path and evidence.get('evidence_write') == 'ok':
+        try:
+            Path(path).write_text(json.dumps(evidence, indent=2, ensure_ascii=False)+'\n', encoding='utf-8')
+        except Exception as exc:
+            evidence['publication_evidence_write_error'] = type(exc).__name__
