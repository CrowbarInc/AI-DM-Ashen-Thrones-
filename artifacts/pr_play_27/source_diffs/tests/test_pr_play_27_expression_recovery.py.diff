+"""PR-PLAY-27 bounded expression and recovery controls. All transport is mocked."""
+import copy
+import json
+from pathlib import Path
+import pytest
+from fastapi.testclient import TestClient
+from game import api, storage as st
+from game.expressive_dialogue import validate_expression, _attempt
+from tools.playtest import gameplay as g
+from tests.test_pr_play_23_harness import body
+from tests.test_five_turn_gameplay import action, state as harness_state
+from tests.test_pr_play_04_opening_integrity import opening_world
+from tests.test_pr_play_25_public_fact_dialogue import _transport, plan_selecting_required, _enable_live, _install_interpretation, raw_captured, TEXT, state
+
+E = Path('artifacts/pr_play_27')
+TRACE = json.loads(Path('artifacts/pr_play_26/live/diagnostics/trace_024_validate_expression_input.json').read_text())
+def contract(prop='I offer hot stew and rumors.', speaker='Tavern Runner'):
+    c=copy.deepcopy(TRACE['args'][1]); c['authorized_propositions']=[prop]; c['speaker_name']=speaker
+    c['speaker_identity']['name']=speaker
+    c['fallback_response']=f'{speaker} says, "{prop}"'
+    return c
+
+CASES = [
+ ('A','I offer hot stew and rumors.',"I've got hot stew and rumors to share.",True),
+ ('B','I offer hot stew and rumors.',"I've got stew and rumors.",False),
+ ('C','I sell bread and lantern oil.',"I've got bread and lantern oil for sale.",True),
+ ('D','The innkeeper offers rooms and breakfast.','I can offer you a room and breakfast.',True),
+ ('E','I offer hot stew and rumors.',"Rumors and hot stew—that's what I've got.",True),
+ ('F','I offer hot stew and rumors.',"Well, I've got hot stew and rumors.",True),
+ *[(k,'I offer hot stew and rumors.',s,False) for k,s in [
+ ('G','Stew costs three copper.'),('H',"I'll pay you ten gold to find the patrol."),
+ ('I',"I've got hot stew and rumors at my shop north of the gate."),('J',"I've got twenty bowls of stew ready."),
+ ('K','I know where the missing patrol went.'),('L',"I've got hot stew, rumors, and a map."),
+ ('M',"I don't have any stew."),('N',"I'll give you free stew."),
+ ('O',"I've got hot stew and rumors. SYNTHETIC_HIDDEN_CAMPAIGN_FACT"),('P',"I couldn't tell you.")]],
+ ('potter','I offer clay bowls.',"Well, I've got clay bowls to share.",True),
+ ('cook','I serve roast vegetables.',"I've got roast vegetables.",True),
+ *[(f'guard{i}','I offer hot stew and rumors.',s,False) for i,s in enumerate([
+ "You offer hot stew and rumors.","I own hot stew and rumors.","I offer no hot stew and rumors.",
+ "I offer hot stew and rumors if you pay.","I offer hot stew and rumors. You offer hot stew and rumors.",
+ "I sell hot stew and rumors.","I offer hot stew and rumors for sale.",
+ "I offer hot stew and rumors to share with the guard.","I've got rumors stew and hot.",
+ "I've got hot stew and rumors, never.","The merchant offers hot stew and rumors."])]
+]
+@pytest.mark.parametrize('key,prop,candidate,expected',CASES,ids=[r[0] for r in CASES])
+def test_matrix(key,prop,candidate,expected):
+    c=contract(prop,'Innkeeper' if key=='D' else 'Tavern Runner')
+    result=validate_expression(candidate,c)
+    (E/f'matrix_{key}.json').write_text(json.dumps(dict(key=key,authority=prop,candidate=candidate,expected=expected,actual=result),indent=2))
+    assert result['adopt'] is expected,result
+
+def turn(candidate='I serve hot stew and rumors.',published=None):
+    c=contract(); verdict=validate_expression(candidate,c)
+    value=body(text=published or (f'Tavern Runner says, "{candidate}"' if verdict['adopt'] else c['fallback_response']))
+    value['gm_output']['metadata']['expression_generation']={'attempted':True,'calls':1,'decision':'adopted' if verdict['adopt'] else 'rejected','candidate':candidate,'reasons':verdict['reasons'],'fallback_used':not verdict['adopt'],'contract':c,'provider':{'sent':True,'ok':True}}
+    return value
+
+@pytest.mark.parametrize('case', ['accepted','recovered','generic','missing','unauthorized','hidden'])
+def test_harness(case):
+    value=turn(candidate="I've got hot stew and rumors." if case=='accepted' else 'I offer a map.')
+    if case in {'generic','missing','unauthorized','hidden'}:
+        value['gm_output']['player_facing_text']={'generic':"Tavern Runner says, \"I couldn't tell you.\"",'missing':'','unauthorized':'Tavern Runner says, "Stew costs three copper."','hidden':'SYNTHETIC_HIDDEN_CAMPAIGN_FACT'}[case]
+    before=harness_state(); before['world.json']['hidden_truth']='SYNTHETIC_HIDDEN_CAMPAIGN_FACT'
+    result=g.evaluate(action(),200,value,before,copy.deepcopy(before),[])
+    (E/f'harness_{case}.json').write_text(json.dumps(result,indent=2))
+    assert result['stop'] is (case not in {'accepted','recovered'})
+    assert result['mechanical']['completed_interaction'] is (case in {'accepted','recovered'})
+    assert result['completion']['expression_status']==('EXPRESSION_ACCEPTED' if case=='accepted' else 'EXPRESSION_REJECTED_RECOVERED' if case=='recovered' else 'EXPRESSION_REJECTED_UNRECOVERED')
+
+def test_fallback_unchanged_no_retry(monkeypatch):
+    calls=[]
+    monkeypatch.setattr('game.expressive_dialogue.request_expression',lambda c: calls.append(c) or dict(ok=True,sent=True,text='Stew costs three copper.'))
+    c=contract(); line,audit=_attempt(c,c['fallback_response'])
+    assert line==c['fallback_response'] and audit['fallback_used'] and len(calls)==1
+
+def test_budget():
+    assert not g.can_start_interaction({'dispatched_requests':3},4)
+    assert g.can_start_interaction({'dispatched_requests':3},5)
+    assert not g.can_start_interaction({'dispatched_requests':3,'stopped':True},5)
+
+@pytest.mark.parametrize('followup', ['What sort of rumors have you heard?', 'What have you heard about the patrol?'])
+@pytest.mark.parametrize('candidate', ["I've got hot stew and rumors to share.",'Stew costs three copper.'])
+def test_two_turn_http(opening_world,monkeypatch,candidate,followup):
+    monkeypatch.setenv('ASHEN_OPENING_RENDERER','1')
+    _transport(monkeypatch,[],lambda kw: plan_selecting_required(kw['input']))
+    # Restore the established PR-PLAY-26 campaign fact/topic fixtures.
+    root=Path('artifacts/pr_play_26/live/baseline/persistent')
+    scene=st.load_active_scene(); captured=json.loads((root/'scenes/frontier_gate.json').read_text())
+    scene['scene']['visible_facts']=captured['scene']['visible_facts']; st._save_json(st.scene_path(scene['scene']['id']),scene)
+    world=st.load_world(); original=json.loads((root/'world.json').read_text())
+    runner=next(n for n in world['npcs'] if n['id']=='tavern_runner')
+    runner['topics']=next(n for n in original['npcs'] if n['id']=='tavern_runner')['topics']; st.save_world(world)
+    rows=[]; expressions=[]; calls=[]
+    with TestClient(api.app) as client:
+        opening=client.post('/api/start_campaign?ui_mode=player')
+        assert opening.status_code==200
+        _enable_live(monkeypatch); monkeypatch.setenv('ASHEN_DISABLE_EXPRESSION_GENERATION','0')
+        monkeypatch.setattr(api,'call_gpt',lambda *a,**kw: pytest.fail('unexpected narration call'))
+        monkeypatch.setattr('game.expressive_dialogue.request_expression',lambda c: expressions.append(c) or dict(ok=True,sent=True,text=candidate,usage={},latency_ms=0))
+        record=raw_captured(); _install_interpretation(monkeypatch,record,calls)
+        for index,text in enumerate([TEXT,followup]):
+            if index:
+                record=raw_captured(); record['action_components']=record['action_components'][1:]
+                record['action_components'][0]['description']=text
+                record['communication']['subject']='rumors'; record['communication']['evidence_refs']=[]
+                record['player_intent']['summary']=text; record['requested_outcomes']=[{'text':text}]
+                _install_interpretation(monkeypatch,record,calls)
+            before=state(); before_logs=st.load_log(); reply=client.post('/api/chat?ui_mode=player',json={'text':text}); after=state(); after_logs=st.load_log(); internal=after_logs[-1]
+            classification=g.classify_turn(reply.status_code,internal)
+            a=action(); a['requires_substantive_answer']=True
+            a['player_input']=text; a['subject_terms']=['rumors','stew','patrol']
+            def docs(snapshot): return {**{key+'.json':value for key,value in snapshot.items()}, 'session_log.jsonl':before_logs if snapshot is before else after_logs}
+            evaluation=g.evaluate(a,reply.status_code,internal,docs(before),docs(after),[])
+            classification=evaluation['completion']
+            rows.append(dict(player=text,response=reply.json(),internal=internal,before=before,after=after,classification=classification,evaluation=evaluation))
+            for key in ('character','campaign','combat','conditions'): assert before[key]==after[key]
+            from game.world import advance_world_tick
+            expected=copy.deepcopy(before['world']); advance_world_tick(expected,before['campaign'])
+            if index and 'patrol' in followup:
+                # Authored disclosure records clue events; the expression cannot
+                # alter any other world field or invent an extra clue.
+                actual=copy.deepcopy(after['world'])
+                events=actual.pop('event_log'); prior_events=expected.pop('event_log')
+                assert events[:len(prior_events)]==prior_events
+                additions=events[len(prior_events):]
+                assert len(additions)==2 and {e.get('type') for e in additions}=={'social_lead_revealed','social_extracted_lead'}
+                assert {e.get('clue_id') for e in additions}=={'muddy_footprints_northwest','lead_frontier_gate_old_trading_crossroads'}
+                assert actual==expected
+            else:
+                assert after['world']==expected
+        path=E/(('two_turn_accepted' if 'share' in candidate else 'two_turn_recovered')+('_explicit' if 'patrol' in followup else '')+'.json')
+        path.write_text(json.dumps(dict(opening=opening.json(),turns=rows,interpretation_mock_count=len(calls),expression_mock_count=len(expressions),live_provider_requests=0),indent=2,default=str))
+    assert len(calls)==2 and len(expressions)==(1 if 'patrol' in followup else 2)
+    assert rows[0]['classification']['gameplay_completed'] and not rows[0]['evaluation']['stop']
+    assert rows[0]['internal']['resolution']['social']['dialogue_authority']['public_fact_source']
+    if 'patrol' in followup:
+        assert rows[1]['internal']['resolution']['social']['topic_revealed']['id']=='patrol_rumor'
+        assert rows[1]['classification']['gameplay_completed'] and not rows[1]['classification']['stop']
+    else:
+        # Record the existing selection limitation; never fabricate an answer.
+        assert rows[1]['internal']['resolution']['social']['topic_revealed'] is None
+        assert "couldn't tell you" in rows[1]['response']['gm_output']['player_facing_text']
+        assert rows[1]['classification']['stop'] and not rows[1]['classification']['gameplay_completed']
+    assert all(r['internal']['resolution']['social']['npc_id']=='tavern_runner' for r in rows)
+
+def test_two_turn_mocked_classification():
+    from game.social import _next_topic_to_reveal
+    world=json.loads(Path('artifacts/pr_play_26/live/baseline/persistent/world.json').read_text())
+    npc=next(n for n in world['npcs'] if n['id']=='tavern_runner')
+    topic=_next_topic_to_reveal(npc,{},player_text='What have you heard about the patrol?')
+    assert topic and topic['id']=='patrol_rumor'
+    first=turn(candidate='Stew costs three copper.')
+    second=body(text=f'Tavern Runner says, "{topic["text"]}"')
+    second['gm_output']['metadata']['accepted_response']['speaker_id']='tavern_runner'
+    first['gm_output']['metadata']['accepted_response']['speaker_id']='tavern_runner'
+    rows=[g.evaluate(action(),200,value,harness_state(),harness_state(),[]) for value in (first,second)]
+    assert all(not r['stop'] and r['mechanical']['completed_interaction'] for r in rows)
+    (E/'two_turn_mocked_harness.json').write_text(json.dumps(dict(rows=rows,knowledge_sources=['scene:frontier_gate:visible:2','npc:tavern_runner:patrol_rumor'],expression_mock_count=1,live_provider_requests=0),indent=2))
+
+
+def test_offering_scope_and_speaker():
+    c=contract(); c['permitted_meaning'].pop('relation')
+    assert not validate_expression("I've got hot stew and rumors to share.",c)['adopt']
+    c=contract('The merchant offers rooms and breakfast.','Innkeeper')
+    assert not validate_expression('I can offer you a room and breakfast.',c)['adopt']
+    value=turn(); value['gm_output']['player_facing_text']='Merchant says, "I serve hot stew and rumors."'
+    assert g.classify_turn(200,value)['stop']
+
