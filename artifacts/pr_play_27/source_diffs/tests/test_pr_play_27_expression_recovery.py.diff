+def test_budget_stops_real_controller_after_recovery(monkeypatch,tmp_path):
+    from tools.playtest import runner
+    monkeypatch.setenv('ASHEN_DISABLE_LIVE_INTERPRETATION','0')
+    monkeypatch.setenv('ASHEN_DISABLE_EXPRESSION_GENERATION','0')
+    calls=[]
+    def completed(run,a,*args):
+        calls.append(a['step_id'])
+        row=g.evaluate(a,200,turn(candidate='Stew costs three copper.'),harness_state(),harness_state(),[])
+        assert not row['stop']
+        path=run/'diagnostics/budget_snapshot.json'
+        # One slot remains, insufficient for interpretation plus expression.
+        usage=json.loads(path.read_text()) if path.exists() else {}
+        # Scenario request ceiling is six (runner scenario_env caps it).
+        usage['dispatched_requests']=5
+        path.write_text(json.dumps(usage))
+        return dict(row,ok=True,action='player_turn')
+    monkeypatch.setattr(g,'execute_turn',completed)
+    run,result=runner.run_playtest(scenario='FiveTurnGameplay',mode='Deterministic',output_root=tmp_path/'runs')
+    (E/'budget_controller.json').write_text(json.dumps(dict(calls=calls,result=result),indent=2,default=str))
+    assert len(calls)==1 and result['stop_reason']=='provider_budget_exhaustion'
+
+def test_original_rejection_against_saved_validator():
+    import importlib.util
+    spec=importlib.util.spec_from_file_location('pr_play_27_before',E/'expressive_dialogue.before.py')
+    old=importlib.util.module_from_spec(spec); spec.loader.exec_module(old)
+    candidate,c=TRACE['args']
+    assert old.validate_expression(candidate,c)['reasons']==['unsupported_addition']
+    assert validate_expression(candidate,c)['adopt']
