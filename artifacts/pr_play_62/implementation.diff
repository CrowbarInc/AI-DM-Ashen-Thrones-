+def _public_target_label(player_text: str, scene_body: dict) -> str | None:
+    """Echo an examination target only when its exact name is already public.
+
+    Raw action IDs can contain normalized player text, so they are not labels.
+    Unknown targets retain generic wording rather than establishing an object.
+    """
+    match = re.fullmatch(
+        r"(?:I\s+)?(?:examine|inspect|investigate|look\s+(?:at|around))\s+"
+        r"(?:the\s+)?([\w -]{1,80}?)(?:\s+again)?[.!?]?", player_text.strip(), re.I)
+    if not match:
+        return None
+    label = match.group(1).strip().casefold()
+    public = " ".join(_strings(scene_body.get("visible_facts")))
+    if not re.search(r"(?<!\w)" + re.escape(label) + r"(?!\w)", public, re.I):
+        return None
+    return label
 
 
