+             'creation_turn': int((session or {}).get('turn_counter') or 0), 'visibility': 'public',
+             'status': 'accepted', 'authority': 'controlled_world_fact', 'truth_status': 'runtime_incidental',
+             'scope': 'scene', 'persistence_status': 'campaign', 'interactions': []}
