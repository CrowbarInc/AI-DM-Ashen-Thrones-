+def verify_engine_publication(resolution, session, player_text, text):
+    """Consume the same request-local binding for a direct engine publication.
+
+    No candidate selection, generation or narration is needed. Retain PR66's
+    invariant on its existing evidence record without claiming AI publication.
+    """
+    binding = _PUBLICATION.get()
+    _PUBLICATION.set(None)
+    sid = str(session.get('campaign_run_id') or session.get('session_id') or '')
+    if not binding or not experimental_publication_enabled(sid):
+        return
+    evidence, bound_resolution, bound_session = binding
+    if (resolution is not bound_resolution or sid != bound_session
+            or evidence.get('player_text') != player_text or not evidence.get('eligible')):
+        return
+    request = evidence.get('authorized_outcome_contract') or {}
+    facts = [f['text'] for f in request.get('must_communicate', [])]
+    if not all(f in text for f in facts):
+        raise ValueError('mandatory_disclosure_publication_failed')
+    evidence['publication'] = dict(decision='fallback', owner='engine', trusted_disclosure='',
+        mandatory_disclosures=facts, final_text=text, invariant='PASS', recovery_reason=None,
+        server_constructed=True, client_received='unknown')
+    evidence['player_facing_published'] = False
+    path = evidence.get('evidence_path')
+    if path and evidence.get('evidence_write') == 'ok':
+        try:
+            Path(path).write_text(json.dumps(evidence, indent=2, ensure_ascii=False)+'\n', encoding='utf-8')
+        except OSError:
+            evidence['publication_evidence_write_error'] = 'OSError'
