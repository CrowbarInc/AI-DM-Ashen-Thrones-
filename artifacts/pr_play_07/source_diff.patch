+def test_capture_count_is_bounded(diagnostic_world,monkeypatch):
+    import game.storage as storage
+    monkeypatch.setenv('ASHEN_DATA_DIR',str(storage.DATA_DIR))
+    monkeypatch.setenv('ASHEN_OPENING_RESPONSE_CAPTURE','1')
