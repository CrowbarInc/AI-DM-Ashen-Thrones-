-def first_obvious_dimension(text: str) -> str | None:
-    """A dimension the utterance itself asks for. None when the request is dimensionless."""
-    for name in _dimensions(text):
-        if name in _OBLIGATORY_DIMENSIONS:
-            return name
-    return None
