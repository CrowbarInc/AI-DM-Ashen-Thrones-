-_NAME_SKIP = frozenset(
-    {
-        "the", "a", "an", "this", "that", "missing", "patrol", "leader", "roster",
-        "house", "ash", "compact", "gate", "notice", "board", "guard", "captain",
-        "i", "no", "one", "they", "he", "she",
