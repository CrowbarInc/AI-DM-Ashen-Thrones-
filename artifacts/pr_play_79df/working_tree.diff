-def _named_event(text: str) -> str:
-    match = _NAMED_EVENT_RE.search(text or "")
-    if not match:
-        return ""
-    event = _clean(match.group("event"), limit=80)
-    if event.lower() in {"that", "this", "it", "them", "they", "him", "her"}:
-        return ""
-    return event
