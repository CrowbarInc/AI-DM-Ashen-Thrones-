-def _decision_from(row: Mapping[str, Any]) -> dict[str, Any]:
-    md = row.get("metadata") if isinstance(row.get("metadata"), Mapping) else {}
-    if isinstance(md.get(DECISION_METADATA_KEY), Mapping):
