-    if actual in (_TRAVEL_BUCKET_UNKNOWN, _TRAVEL_BUCKET_GENERIC):
-        return True
-    if expected == actual:
-        return True
-    pairs = {_TRAVEL_BUCKET_INTERIOR, _TRAVEL_BUCKET_OUTDOOR}
-    if expected in pairs and actual in pairs and expected != actual:
-        return False
-    return True
