-_OBLIGATORY_DIMENSIONS = frozenset(
-    {DIM_CONFIDENCE, DIM_USE, DIM_TIME, DIM_SOURCE, DIM_LOCATION, DIM_CONTENT, DIM_NEXT_STEP}
