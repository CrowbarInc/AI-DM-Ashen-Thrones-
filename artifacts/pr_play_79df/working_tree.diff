+        return []
+    if "?" in raw or _QUESTION_START_RE.search(raw):
+        return []
+    player_tokens = set(_content_tokens(raw))
+    pursuit = bool(player_tokens & _PURSUIT_OBJECT_HINTS or re.search(r"\b(?:follow|pursue)\b", raw, re.IGNORECASE))
+    lowered = raw.casefold()
