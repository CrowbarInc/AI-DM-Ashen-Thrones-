-    r"(?:say|name|swear|give|tell|share)\b"
-    r"|\b(?:does not|doesn't|do not|don't|not)\s+"
-    r"(?:specify|name|state|list|post|establish|fix)\b"
-    r"|\bno\s+(?:fixed|posted|set)\s+(?:toll|time|schedule|curfew|price)\b",
-    re.IGNORECASE,
