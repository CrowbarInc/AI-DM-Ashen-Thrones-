-def _is_clarification_text(text: str) -> bool:
-    if not _CLARIFICATION_TEXT_RE.search(text or ""):
-        return False
-    return "?" in str(text or "") or bool(re.search(r"\b(?:asks?|asking)\b", text or "", re.IGNORECASE))
