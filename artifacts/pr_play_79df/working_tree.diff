-def _entry_id(kind: str, scene_id: str, content: str, speaker_id: str = "") -> str:
-    basis = f"{kind}|{scene_id}|{speaker_id}|{content}".lower()
-    digest = hashlib.sha1(basis.encode("utf-8")).hexdigest()[:12]
-    return f"bi_{digest}"
