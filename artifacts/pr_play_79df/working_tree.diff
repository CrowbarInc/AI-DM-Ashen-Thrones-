-        "sensory_detail",
-        "food_composition",
-        "mundane_service_detail",
-        "background_npc_detail",
-        "mannerism",
-        "local_color",
-        "environmental_elaboration",
-        "social_connective",
-        "ordinary_personal_detail",
-    }
-)
-ALLOWED_NPC_CLAIM_CATEGORIES = frozenset(
