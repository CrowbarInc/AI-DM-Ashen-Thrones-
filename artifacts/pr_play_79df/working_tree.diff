-        return None
-    pcf = phrase.casefold().strip()
-    if len(pcf) < 2:
-        return None
-    best: Optional[Dict[str, Any]] = None
-    best_len = 0
-    for ex in exits:
-        if not isinstance(ex, dict):
-            continue
-        lab = str(ex.get("label") or "").strip()
-        if not lab:
-            continue
-        lcf = lab.casefold()
-        if pcf in lcf or lcf in pcf:
-            if len(lab) > best_len:
-                best_len = len(lab)
-                best = ex
-    return best
