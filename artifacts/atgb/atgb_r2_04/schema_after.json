{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipient": {
          "type": "string",
          "enum": [
            "GM",
            "NPC",
            "CHARACTER",
            "SESSION",
            "MIXED",
            "AMBIGUOUS"
          ],
          "description": "Communicative function of the whole turn, not the person mentioned. GM: asks the facilitator about the world, including interpreting another person's behavior. NPC: the character actually speaks to that person. SESSION: mechanics or play procedure. CHARACTER: committed physical attempt. MIXED: distinct speech/action intentions, including conditional action. AMBIGUOUS: unresolved referent."
        },
        "purpose": {
          "type": "string",
          "enum": [
            "QUESTION",
            "DESCRIPTION",
            "EXPLANATION",
            "RECALL",
            "RULES",
            "ACTION",
            "OBSERVATION",
            "CORRECTION",
            "WITHDRAWAL",
            "CONFIRMATION",
            "TENTATIVE",
            "CLARIFICATION"
          ],
          "description": "Speech act, independent of executable operations: CONFIRMATION accepts pending work; CORRECTION corrects conversational meaning, subject, referent or description, or revises an actual unexecuted intention. Conversational correction does not itself revise a gameplay action. CLARIFICATION can describe a player's request for explanation; it does not by itself mean the AI-DM needs more information. WITHDRAWAL cancels pending intent; RULES asks play procedure; EXPLANATION asks cause or meaning. These control acts are never ACTION, even when mentioning a physical operation."
        },
        "subject": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "recipient",
        "purpose",
        "subject",
        "evidence_refs"
      ]
    },
    "communication_mode": {
      "enum": [
        "CLARIFICATION",
        "IN_WORLD_ACTION",
        "OTHER",
        "OUT_OF_CHARACTER_CORRECTION",
        "RULES_QUESTION"
      ]
    },
    "interpretation_status": {
      "enum": [
        "ABSTAIN",
        "CLARIFICATION_REQUIRED",
        "INTERPRETED",
        "UNSUPPORTED_REQUEST"
      ]
    },
    "player_intent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ]
    },
    "asserted_premises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "requested_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    "action_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "order": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "target_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "operation_class": {
            "enum": [
              "ASK",
              "ATTACK",
              "CANON_DECLARATION",
              "DICE_OVERRIDE",
              "FOLLOW",
              "HIDDEN_INFORMATION_REQUEST",
              "HP_ASSIGNMENT",
              "INSPECT",
              "INVENTORY_GRANT",
              "MOVE",
              "NPC_COMMITMENT",
              "PERCEIVE",
              "RETCON",
              "SOCIAL_SIGNAL",
              "STEALTH_MODE_TOGGLE",
              "TIME_CONTROL",
              "UNSUPPORTED_MECHANIC",
              "USE_VISIBLE_OBJECT"
            ]
          }
        },
        "required": [
          "order",
          "description",
          "target_ref",
          "operation_class"
        ]
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permitted_entity_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "permitted_entity_ids",
        "unresolved_references"
      ]
    },
    "clarification_question": {
      "type": "string"
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "enum": [
            "COMMITTED_ACTION",
            "INTENTION",
            "NONE",
            "REFERENT"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "subject",
        "note"
      ]
    }
  },
  "required": [
    "action_components",
    "asserted_premises",
    "clarification_question",
    "communication_mode",
    "correction",
    "interpretation_status",
    "player_intent",
    "references",
    "requested_outcomes",
    "communication"
  ]
}
