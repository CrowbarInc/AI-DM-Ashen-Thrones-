{
  "id": "ScriptedObservation",
  "version": 1,
  "description": "Deterministic opening, scene observation, and explicit state verification",
  "fixture": "frontier-gate-v1",
  "execution_modes": [
    "ScriptedGameplay",
    "Deterministic"
  ],
  "actions": [
    {
      "kind": "initialize_campaign"
    },
    {
      "kind": "capture_baseline"
    },
    {
      "kind": "start_campaign"
