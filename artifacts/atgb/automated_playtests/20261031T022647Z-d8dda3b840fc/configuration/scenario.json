  "evidence_requirements": [
    "provider_usage.jsonl",
    "baseline",
    "after",
    "result.json",
    "SUMMARY.md"
  ],
  "stop_conditions": [
    "first_failed_step",
    "budget_exhaustion",
    "timeout",
    "interruption"
  ]
