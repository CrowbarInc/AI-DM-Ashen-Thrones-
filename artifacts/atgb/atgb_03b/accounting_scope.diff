+_PASSIVE_ACTION_CUES: tuple[tuple[str, str], ...] = (
+    ("hold position", "hold_position"),
+    ("remain silent", "remain_silent"),
+    ("stay silent", "remain_silent"),
+    ("say nothing", "remain_silent"),
+    ("keep watching", "watch"),
+    ("look around", "observe"),
+    ("wait", "wait"),
+    ("watch", "watch"),
+    ("observe", "observe"),
