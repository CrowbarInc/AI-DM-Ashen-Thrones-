+        "label": original_text,
+        "prompt": original_text,
+        "success": None,
+        "resolved_transition": False,
+        "target_scene_id": None,
+        "discovered_clues": [],
+        "world_updates": None,
+        "state_changes": {},
+        "metadata": {
