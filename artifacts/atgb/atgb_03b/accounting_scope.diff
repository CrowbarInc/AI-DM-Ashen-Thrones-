+            _record_post_gm_mutation_trace(
+                session,
+                operation="observe_missing_response_policy_enforcement_marker",
+                source="post_gm_adoption_semantic_policy_audit",
+                affected_domains=[SCENE_STATE, WORLD_STATE],
