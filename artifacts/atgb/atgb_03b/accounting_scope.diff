+_LATENCY_TRACE_KEYS = (
+    "intent_classification",
+    "engine_resolution",
+    "prompt_construction",
+    "gpt_call",
+    "retry_loop_total",
+    "final_emission_gate",
+    "fallback_repair",
+    "total_turn",
+)
