+def _split_leading_sentences(text: str, max_sentences: int = 2) -> List[str]:
+    """First one or two sentence-like units (strict-social contract scope)."""
+    t = str(text or "").strip()
+    if not t:
+        return []
+    parts = re.split(r"(?<=[.!?])\s+", t)
+    out: List[str] = []
+    for p in parts:
+        s = p.strip()
+        if s:
+            out.append(s)
+        if len(out) >= max_sentences:
+            break
+    return out
+
