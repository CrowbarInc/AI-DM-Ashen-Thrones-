+    usage = attempt.finish(
+        {
+            "purpose": "expression",
+            "sent": True,
+            "configured_model": DEFAULT_MODEL_NAME,
+            "model": model,
+            "request_id": getattr(response, "id", None),
+            "input_tokens": incoming,
+            "output_tokens": outgoing,
+            "total_tokens": total,
+            "latency_ms": latency,
