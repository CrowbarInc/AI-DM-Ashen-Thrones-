+def historical_disclosure_permitted(row: Mapping[str, Any], npc: Mapping[str, Any] | None) -> bool:
+    """History is evidence of delivery, not an override of current source policy."""
+    topic_id = str(row.get("topic_id") or "")
+    if topic_id:
+        topics = (npc or {}).get("topics") or (npc or {}).get("knowledge") or []
+        return any(isinstance(t, Mapping) and str(t.get("id") or "") == topic_id
+                   and npc_source_permitted(npc, t)
+                   and str(row.get("authorized_proposition") or row.get("supplied_text") or "")
+                   == str(t.get("text") or t.get("clue_text") or "") for t in topics)
+    return bool(row.get("response_integrity_digest") and row.get("authorization_source"))
+
