+def commitment_disclosure_permitted(row: Mapping[str, Any], npc: Mapping[str, Any] | None) -> bool:
+    proposition = str(row.get("authorized_proposition") or "")
+    if proposition:
+        return npc_source_permitted(npc, {"text": proposition, "id": row.get("topic_id") or ""})
+    return row.get("disclosure_scope") == "nonconsequential_host_speech"
